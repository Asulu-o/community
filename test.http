### 1. 登录获取Token
POST http://localhost:8080/user/login
Content-Type: application/json

{
  "username": "lisi",
  "password": "123456"
}

### 2. 发布文章
POST http://localhost:8080/article/publish
Content-Type: application/json
Authorization: Bearer 你的Token

{
  "title": "我的第一篇文章",
  "content": "这是文章内容",
  "status": 2
}

### 3. 查看我的文章列表
GET http://localhost:8080/article/my-list
Authorization: Bearer 你的Token
### 发布文章
POST http://localhost:8080/article/publish
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJsaXNpIiwiaWF0IjoxNzc5MDc1NjUyLCJleHAiOjE3Nzk2ODA0NTJ9.EU8XtpZFxMOezduOY51LNoB6n-m0n2yZcTS-YTvkrzI

{
  "title": "我的第一篇文章",
  "content": "这是文章内容",
  "status": 2
}

### 查询我的文章列表
GET http://localhost:8080/article/my-list
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJsaXNpIiwiaWF0IjoxNzc5MDc1NjUyLCJleHAiOjE3Nzk2ODA0NTJ9.EU8XtpZFxMOezduOY51LNoB6n-m0n2yZcTS-YTvkrzI

### 查询我的文章列表
GET http://localhost:8080/article/my-list
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJsaXNpIiwiaWF0IjoxNzc5MDc1NjUyLCJleHAiOjE3Nzk2ODA0NTJ9.EU8XtpZFxMOezduOY51LNoB6n-m0n2yZcTS-YTvkrzI

### 查询单篇文章
GET http://localhost:8080/article/1

### 更新文章
PUT http://localhost:8080/article/1
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJsaXNpIiwiaWF0IjoxNzc5MDc1NjUyLCJleHAiOjE3Nzk2ODA0NTJ9.EU8XtpZFxMOezduOY51LNoB6n-m0n2yZcTS-YTvkrzI

{
  "title": "修改后的标题",
  "content": "修改后的内容",
  "status": 2
}

### 删除文章
DELETE http://localhost:8080/article/1
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJsaXNpIiwiaWF0IjoxNzc5MDc1NjUyLCJleHAiOjE3Nzk2ODA0NTJ9.EU8XtpZFxMOezduOY51LNoB6n-m0n2yZcTS-YTvkrzI


